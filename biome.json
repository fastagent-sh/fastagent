{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/deploy/agentcore/forwarder.js",
      "test/**/*.ts",
      "!src/scaffold/templates/**",
      "!src/channels/*/scaffold/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "assist": {
    "actions": {
      "source": { "organizeImports": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["src/deploy/agentcore/forwarder.js"],
      "linter": { "rules": { "suspicious": { "noRedundantUseStrict": "off" } } }
    },
    {
      "includes": ["test/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}
