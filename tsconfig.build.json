{
  // Publish build only. Emits .js + .d.ts
  // to dist/, which is what the package ships — Node refuses to type-strip .ts under node_modules,
  // so consumers must receive compiled JavaScript. rewriteRelativeImportExtensions rewrites the
  // source's explicit `./x.ts` import specifiers to `./x.js` in the output.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  // tsconfig.json's own exclusions, repeated because `exclude` replaces them, and pi-durable's port: not shipped until an
  // agent can choose it, since its packages are devDependencies (docs/design/agent-service.md §9.1).
  "exclude": ["src/scaffold/templates", "src/channels/*/scaffold", "src/harnesses/pi-durable"]
}
