{
  "name": "fastagent-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/client",
    "packages/client-agentcore",
    "packages/fastagent",
    "packages/agentcore",
    "packages/harness-dsh"
  ],
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.4.4"
  },
  "overrides": {
    "undici": ">=8.13.1"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest --run --project unit",
    "test:guards": "vitest --run --project unit test/guards",
    "test:integration": "vitest --run --project integration",
    "typecheck": "effect-tsgo tsc --noEmit",
    "lint": "biome check packages test && node scripts/check-doc-links.mjs && knip",
    "format": "biome check --write packages test",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "knip": "knip"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1175.0",
    "@biomejs/biome": "^2.6.8",
    "@effect/tsgo": "^0.73.4",
    "@effect/vitest": "^4.1.5",
    "@electric-sql/pglite": "^0.6.0",
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/proper-lockfile": "^4.1.4",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "knip": "^6.48.0",
    "vitest": "^5.1.1"
  }
}
