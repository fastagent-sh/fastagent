{
  "compilerOptions": {
    "target": "ES2025",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2025"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "includeSuggestionsInTsc": false,
        // Schema.Opaque in agent-api.ts intentionally models structural JSON DTOs; keep nominal brand checks on classes & errors.
        "brandedSchemaClasses": ["Class", "TaggedClass", "Error", "TaggedError"],
        "allowedUnstableApis": [
          "@effect/platform-node/NodeHttpServer",
          "effect/ByteSize",
          "effect/encoding/Sse",
          "effect/http",
          "effect/http-api",
          "effect/net/NetAddress"
        ],
        "diagnosticSeverity": {
          "floatingEffect": "error"
        },
        "overrides": [
          {
            "include": ["test/**/*.ts"],
            "options": {
              "allowedUnstableApis": [
                "@effect/platform-node/NodeHttpServer",
                "@effect/vitest",
                "effect/Arbitrary",
                "effect/ByteSize",
                "effect/encoding/Sse",
                "effect/http",
                "effect/http-api",
                "effect/net/NetAddress"
              ]
            }
          }
        ]
      }
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    // One package reads another's source in the repository: here by path, and in Node through the export condition
    // `@fastagent-sh/source` (test/setup.ts). A published package has no `src/`, and its consumers never name either.
    "paths": {
      "@fastagent-sh/client": ["./packages/client/src/index.ts"],
      "@fastagent-sh/client/*": ["./packages/client/src/*.ts"],
      "@fastagent-sh/client-agentcore": ["./packages/client-agentcore/src/index.ts"],
      "@fastagent-sh/client-agentcore/*": ["./packages/client-agentcore/src/*.ts"],
      "@fastagent-sh/fastagent": ["./packages/fastagent/src/index.ts"],
      "@fastagent-sh/fastagent/*": ["./packages/fastagent/src/*.ts"],
      "@fastagent-sh/agentcore": ["./packages/agentcore/src/index.ts"],
      "@fastagent-sh/agentcore/*": ["./packages/agentcore/src/*.ts"],
      "@fastagent-sh/pi-remote": ["./packages/pi-remote/src/index.ts"],
      "@fastagent-sh/pi-remote/*": ["./packages/pi-remote/src/*.ts"],
      "@fastagent-sh/harness-dsh": ["./packages/harness-dsh/src/index.ts"],
      "@fastagent-sh/harness-dsh/*": ["./packages/harness-dsh/src/*.ts"]
    }
  },
  "include": ["packages/*/src", "test"],
  // Scaffold payload: real template files copied verbatim into a new workspace. They import the published
  // @fastagent-sh/fastagent, not this source, so they are data here, not part of the build.
  "exclude": ["packages/fastagent/src/scaffold/templates"]
}
