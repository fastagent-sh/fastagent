{
  "name": "@fastagent-sh/fastagent",
  "version": "0.33.0",
  "description": "Vibe first. Then FastAgent: turn a local agent directory into a live service in your app or behind the Agent API, durable across restarts.",
  "keywords": [
    "agent",
    "ai-agent",
    "llm",
    "agents.md",
    "agent-skills",
    "agent-serving",
    "sse",
    "pi",
    "fastagent"
  ],
  "license": "MIT",
  "author": "the fastagent authors (https://github.com/fastagent-sh/fastagent)",
  "homepage": "https://fastagent.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastagent-sh/fastagent.git"
  },
  "bugs": {
    "url": "https://github.com/fastagent-sh/fastagent/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@fastagent-sh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./platform": {
      "@fastagent-sh/source": "./src/platform.ts",
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "fastagent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node ../../scripts/copy-scaffold-assets.mjs",
    "prepack": "node ../../scripts/prepack.mjs --readme && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@earendil-works/pi-telemetry": "1.5.2",
    "@effect/platform-node": "^4.0.7",
    "@fastagent-sh/client": "0.33.0",
    "@modelcontextprotocol/client": "2.4.0",
    "chokidar": "^6.0.0",
    "commander": "^15.0.0",
    "effect": "^4.0.7",
    "ignore": "^7.0.14",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "proper-lockfile": "^4.1.2",
    "undici": "^8.6.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
