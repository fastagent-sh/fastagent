{
  "name": "@fastagent-sh/client-agentcore",
  "version": "0.36.1",
  "description": "FastAgent Agent API client for Amazon Bedrock AgentCore: connectAgentCore, connectAgentCoreAuth, and remotes.json transport plugin. Zero server or Node-only dependencies.",
  "keywords": [
    "agent",
    "ai-agent",
    "agent-api",
    "agentcore",
    "aws",
    "fastagent"
  ],
  "license": "MIT",
  "author": "the fastagent authors (https://github.com/fastagent-sh/fastagent)",
  "homepage": "https://github.com/fastagent-sh/fastagent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastagent-sh/fastagent.git"
  },
  "bugs": {
    "url": "https://github.com/fastagent-sh/fastagent/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@fastagent-sh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/prepack.mjs && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1175.0",
    "@fastagent-sh/client": "0.36.1"
  }
}
