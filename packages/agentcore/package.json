{
  "name": "@fastagent-sh/agentcore",
  "version": "0.31.0",
  "description": "Run a FastAgent agent on Amazon Bedrock AgentCore: the runtime, its Caller, and Aurora DSQL as its database.",
  "keywords": [
    "agent",
    "ai-agent",
    "agentcore",
    "aws",
    "aurora-dsql",
    "fastagent"
  ],
  "license": "MIT",
  "author": "the fastagent authors (https://github.com/fastagent-sh/fastagent)",
  "homepage": "https://fastagent.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastagent-sh/fastagent.git"
  },
  "bugs": {
    "url": "https://github.com/fastagent-sh/fastagent/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@fastagent-sh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@fastagent-sh/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./cli": {
      "@fastagent-sh/source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/prepack.mjs && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1170.0",
    "@aws-sdk/dsql-signer": "^3.1170.0",
    "@effect/platform-node": "^4.0.7",
    "@fastagent-sh/client": "0.31.0",
    "effect": "^4.0.7"
  },
  "peerDependencies": {
    "@fastagent-sh/fastagent": "0.31.0"
  },
  "peerDependenciesMeta": {
    "@fastagent-sh/fastagent": {
      "optional": true
    }
  }
}
