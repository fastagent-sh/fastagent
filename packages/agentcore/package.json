{
  "name": "@fastagent-sh/agentcore",
  "version": "0.35.2",
  "description": "Run a FastAgent agent on Amazon Bedrock AgentCore: the runtime, Aurora DSQL, and Secrets Manager.",
  "keywords": [
    "agent",
    "ai-agent",
    "agentcore",
    "aws",
    "aurora-dsql",
    "fastagent"
  ],
  "license": "MIT",
  "author": "the fastagent authors (https://github.com/fastagent-sh/fastagent)",
  "homepage": "https://github.com/fastagent-sh/fastagent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastagent-sh/fastagent.git"
  },
  "bugs": {
    "url": "https://github.com/fastagent-sh/fastagent/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "cdk": [
        "./dist/cdk.d.ts"
      ],
      "cli": [
        "./dist/cli.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "@fastagent-sh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "@fastagent-sh/source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./cdk": {
      "@fastagent-sh/source": "./src/cdk.ts",
      "types": "./dist/cdk.d.ts",
      "default": "./dist/cdk.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/prepack.mjs && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1175.0",
    "@aws-sdk/dsql-signer": "^3.1175.0",
    "@effect/platform-node": "^4.1.5",
    "@fastagent-sh/client": "0.35.2",
    "effect": "^4.1.5"
  },
  "peerDependencies": {
    "@fastagent-sh/client-agentcore": "0.35.2",
    "@fastagent-sh/fastagent": "0.35.2",
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.7.0"
  },
  "peerDependenciesMeta": {
    "@fastagent-sh/client-agentcore": {
      "optional": true
    },
    "@fastagent-sh/fastagent": {
      "optional": true
    },
    "aws-cdk-lib": {
      "optional": true
    },
    "constructs": {
      "optional": true
    }
  }
}
