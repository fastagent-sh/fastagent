{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["test/**/*.test.ts", "test/smoke/*/*.ts", "scripts/*.mjs"],
      "project": ["test/**/*.ts", "scripts/*.mjs"],
      "ignoreDependencies": [
        "@aws-sdk/client-bedrock-agentcore",
        "@earendil-works/.+",
        "@effect/language-service",
        "ignore"
      ]
    },
    "packages/client": {
      "project": ["src/**/*.ts"],
      "includeEntryExports": true
    },
    "packages/client-agentcore": {
      "project": ["src/**/*.ts"],
      "includeEntryExports": true
    },
    "packages/fastagent": {
      "entry": ["src/cli.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["src/scaffold/templates/**"]
    },
    "packages/agentcore": {
      "project": ["src/**/*.ts"],
      "includeEntryExports": true,
      "ignoreDependencies": ["@fastagent-sh/fastagent"]
    },
    "packages/harness-dsh": {
      "project": ["src/**/*.ts"],
      "includeEntryExports": true,
      "ignoreDependencies": ["@fastagent-sh/fastagent"]
    }
  },
  "ignoreBinaries": ["fastagent", "flock", "tsc"]
}
