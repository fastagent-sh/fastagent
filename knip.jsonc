{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // A package's entries are its package.json "exports", read through their `@fastagent-sh/source` condition, and its
  // bin's source.
  "workspaces": {
    ".": {
      "entry": ["test/**/*.test.ts", "test/smoke/*/*.ts", "scripts/*.mjs"],
      "project": ["test/**/*.ts", "scripts/*.mjs"],
      // The tests exercise the packages through these, the packages' own dependencies, installed at the root.
      // aws-cdk-lib and constructs: @fastagent-sh/agentcore's optional peers, installed here for its typecheck and tests.
      "ignoreDependencies": ["@earendil-works/.+", "effect", "ignore", "aws-cdk-lib", "constructs"]
    },
    "packages/client": {
      "project": ["src/**/*.ts"],
      // `/agent-api` and `/http/contract` are entries only FastAgent's runtime imports: an export no package uses is
      // dead, not public. The root entry's exports are public (`@public`).
      "includeEntryExports": true
    },
    "packages/agentcore": {
      "project": ["src/**/*.ts"],
      // Optional peers: the runtime's entry needs the agent's own FastAgent, the construct (`/cdk`) its CDK app's
      // aws-cdk-lib, and a Caller's entry (`/client`) installs none of them.
      "ignoreDependencies": ["@fastagent-sh/fastagent", "aws-cdk-lib", "constructs"]
    },
    "packages/fastagent": {
      "entry": ["src/cli.ts"],
      "project": ["src/**/*.ts"],
      // Scaffold templates are copied as files at scaffold time, never imported.
      "ignore": ["src/scaffold/templates/**"]
    }
  },
  // `tsc` is the fastagent package's devDependency, the TypeScript `fastagent build` gives an agent, installed at the
  // root for every package's build and the typecheck.
  "ignoreBinaries": ["fastagent", "flock", "tsc"]
}
