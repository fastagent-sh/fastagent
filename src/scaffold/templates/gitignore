# This file is yours — fastagent writes it once, at `init`, and never touches git again.
# (`.secrets/` carries its own, so the credentials stay protected however you edit this one.)

# dependencies (reinstalled at deploy). No trailing slash on purpose: `node_modules/` matches only a
# DIRECTORY, so a symlinked one (pnpm, a shared store) would show up as untracked.
node_modules

# generated: `fastagent build`'s package, and FastAgent's own files, a local instance's state, working directory and
# clones of the agent's content included (`.fastagent/dev/`, `.fastagent/start/`)
/dist
.fastagent
# the same, where an instance is placed in the agent's directory (`--state`, `--root`), and on a deployed host, where
# `content/` is a link to the volume (no trailing slash, since a link is not a directory)
.state
/content
.cache

# the development instance's configuration: its app is one person's, so it is personal. What a team shares goes in
# `defaults` of fastagent.config.ts, or in a deployment's configuration (`deploy --config`).
fastagent.json

# fastagent reads the agent's env from .secrets/.env (which un-ignores its own .env.example). A bare
# .env at THIS level is the file habit puts here — `dev` says so when it finds one; this keeps it
# uncommittable meanwhile.
.env
.env.*
